{
  "id": "SsCutscene_Mentor",
  "version": 1,
  "skippable": true,
  "speakers": {
    "hero": { "name": "阿甲", "portrait": "SsPortraitHero_Face", "side": "left" },
    "mentor": { "name": "龜婆", "portrait": "SsPortraitMentor_Face", "side": "right" }
  },
  "commands": [
    { "op": "move", "actor": "hero", "x": 73, "speed": 3 },
    { "op": "face", "actor": "hero", "dir": "right" },
    { "op": "face", "actor": "mentor", "toward": "hero" },
    { "op": "say", "who": "mentor", "face": "surprised", "text": "阿甲！你還在路上？大口集團的人把整條街都封了。" },
    { "op": "say", "who": "hero", "text": "龜婆。路上有幾隻老鼠，已經處理了。" },
    { "op": "say", "who": "mentor", "face": "angry", "text": "前面更麻煩。天上有監工鴿，地上還有拿盾牌的保全犀牛。" },
    { "op": "say", "who": "mentor", "text": "光靠甩包可不夠。來，這個給你。" },

    { "op": "grant", "attack": "Sling" },
    { "op": "say", "who": "mentor", "face": "happy", "text": "急件彈弓！按住上再射，可以打天上的鴿子。" },
    { "op": "say", "who": "hero", "face": "surprised", "text": "……這不是我小時候的彈弓嗎？" },
    { "op": "say", "who": "mentor", "face": "happy", "text": "我幫你改過了。還有這一套。" },

    { "op": "fade", "to": 1, "time": 0.2, "color": "white" },
    { "op": "grant", "costume": "Express", "equip": true, "banner": false },
    { "op": "grant", "attack": "Roll", "banner": false },
    { "op": "fade", "to": 0, "time": 0.4, "color": "white" },
    { "op": "banner", "text": "獲得：特急制服、滾殼衝撞", "time": 1.8 },
    { "op": "say", "who": "mentor", "text": "特急制服！背殼加了鋼板，滾起來可以直接撞破盾牌。" },
    { "op": "say", "who": "hero", "text": "穿這樣送件，客人會以為我要去比賽。" },
    { "op": "say", "who": "mentor", "text": "比賽也好，送件也好，你記住——" },
    { "op": "say", "who": "mentor", "face": "happy", "text": "龜速快遞，從來沒有遲到過。" },
    { "op": "say", "who": "hero", "text": "那是因為我們從來不說幾點到。" },
    { "op": "say", "who": "mentor", "face": "angry", "text": "少廢話！快去！五點前！" },
    { "op": "setFlag", "flag": "mentor_done" }
  ]
}
